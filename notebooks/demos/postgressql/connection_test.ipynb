   "outputs": [],
   "source": [
    "from pandas import read_sql\n",
    "\n",
    "from postgre_tools import Users, create_postgres_engine\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4120dd0f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Connected!\n"
     ]
    }
   ],
   "source": [
    "engine = create_postgres_engine(Users.DEMO.load_user())\n",
    "\n",
    "df = read_sql(\n",
    "    \"SELECT * FROM friends;\",\n",
    "    engine,\n",
    ")\n",
    "print(\"Connected!\")\n",
    "engine.dispose()"
   ]
  },
